<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VSCode Modelator — OpenAI-compatible Model Converter</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%231a1a2e'/><text x='50' y='68' font-size='55' text-anchor='middle' fill='%239eb7ff' font-family='system-ui'>⚡</text></svg>">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="assets/style.css" />
</head>
<body>
    <div class="app-layout">
        <!-- LEFT: Form -->
        <div class="main-panel" id="mainPanel">
            <div class="container">
                <h1><span class="material-symbols-outlined">mobile_code</span> VSCode Modelator <button class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode"><span class="material-symbols-outlined icon-dark">dark_mode</span><span class="material-symbols-outlined icon-light">light_mode</span></button></h1>
                <p class="subtitle">Bridge your OpenAI compatible models to Visual Studio Code custom models.</p>
                <div class="tabs">
                    <button id="tabFetch" class="active" onclick="switchTab('fetch')"><span class="material-symbols-outlined tab-icon">bolt</span> Fetch from API</button>
                    <button id="tabPaste" onclick="switchTab('paste')"><span class="material-symbols-outlined tab-icon">content_paste</span> Paste JSON</button>
                    <button id="tabScripts" onclick="switchTab('scripts')"><span class="material-symbols-outlined tab-icon">code_blocks</span> Scripts</button>
                </div>
                <div id="fetchPanel">
                    <div class="endpoint-list" id="endpointList">
                        <!-- Endpoint rows injected by JS -->
                    </div>
                    <button class="add-endpoint-btn" onclick="addEndpoint()" type="button"><span class="material-symbols-outlined btn-icon">add</span> Add Endpoint</button>
                    <div class="row output-row">
                        <div class="field">
                            <label for="outputFile"><span class="material-symbols-outlined label-icon">edit_note</span> Output File Name</label>
                            <input type="text" id="outputFile" value="chatLanguageModels.json">
                        </div>
                    </div>
                    <button id="fetchBtn" onclick="runFetchAll()"><span class="material-symbols-outlined btn-icon">bolt</span> Fetch All & Merge</button>
                    <div id="corsHint" class="hint-box hidden">
                        <strong>🔒 Mixed content blocked?</strong><br>Browser from <code>https://</code> page cannot fetch <code>http://localhost</code>.<br><br>
                        <strong>Options:</strong><br>• Open this page via <code>file://</code> — double-click <code>index.html</code><br>• Run a local server: <code>python -m http.server 8080</code><br>• Use the <strong>Paste JSON</strong> tab instead<br>• Use the <code>.bat</code> / <code>.sh</code> / <code>.py</code> script
                    </div>
                </div>
                <div id="pastePanel" class="hidden">
                    <div class="field">
                        <label for="pasteInput"><span class="material-symbols-outlined label-icon">terminal</span> Paste raw JSON response from /v1/models</label>
                        <textarea class="paste-area" id="pasteInput" placeholder='{"object":"list","data":[{"id":"gpt-4o","capabilities":{...}}]}'></textarea>
                    </div>
                    <div class="field">
                        <label><span class="material-symbols-outlined label-icon">upload</span> Or upload models_raw.json</label>
                        <div class="upload-zone" id="uploadZone">
                            <input type="file" id="fileUpload" accept=".json" onchange="handleFileUpload(event)">
                            <label for="fileUpload" class="upload-label"><span class="material-symbols-outlined upload-icon">upload</span> Click to select or drop models_raw.json here</label>
                        </div>
                    </div>
                    <div class="field">
                        <label for="pasteApiKey"><span class="material-symbols-outlined label-icon">key</span> API Key / Token</label>
                        <div class="input-row">
                            <input type="password" id="pasteApiKey" placeholder="${input:chat.lm.secret.-65d90303}">
                            <button type="button" class="paste-btn" onclick="pasteField('pasteApiKey')" title="Paste from clipboard"><span class="material-symbols-outlined">content_paste</span></button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="field">
                            <label for="pasteProviderName"><span class="material-symbols-outlined label-icon">badge</span> Custom Endpoint Name</label>
                            <input type="text" id="pasteProviderName" value="9Router" placeholder="Provider name">
                        </div>
                        <div class="field">
                            <label for="pasteOutputFile"><span class="material-symbols-outlined label-icon">edit_note</span> Output File Name</label>
                            <input type="text" id="pasteOutputFile" value="chatLanguageModels.json">
                        </div>
                        <div class="field paste-convert-row">
                            <button onclick="runPaste()"><span class="material-symbols-outlined btn-icon">code</span> Convert</button>
                        </div>
                    </div>
                    <div class="hint-box">
                        <div class="curl-header">
                            <strong>How to get JSON:</strong>
                            <button class="copy-curl-btn" onclick="copyCurlCommand()" title="Copy to clipboard"><span class="material-symbols-outlined">content_paste</span> Copy</button>
                        </div>
                        <div class="curl-box"><code id="curlCommand">curl -s -H "Authorization: Bearer YOUR_TOKEN" http://localhost:20128/v1/models</code></div>
                        Or download the fetch script from the <strong>Scripts</strong> tab.
                    </div>
                </div>
                <div id="scriptsPanel" class="hidden">
                    <div class="hint-box">
                        <strong>💡 Workflow when localhost is not accessible:</strong><br>
                        1. Download a <strong>Fetch</strong> script → run on machine with access → produces <code>models_raw.json</code><br>
                        2. Come back here → <strong>Paste JSON</strong> tab → upload <code>models_raw.json</code><br>
                        3. Convert to <code>chatLanguageModels.json</code> → download or copy
                    </div>
                    <div class="scripts-panel" id="scriptsPanelInner"></div>
                </div>
                <div id="status" class="status"></div>
            </div>
        </div>
        <!-- RIGHT: Editor -->
        <div class="side-panel" id="sidePanel">
            <div class="panel-header">
                <div class="panel-header-left">
                    <span class="material-symbols-outlined panel-header-icon">data_object</span>
                    <span class="panel-header-title">chatLanguageModels.json</span>
                    <span class="panel-header-badge hidden" id="modelCount"></span>
                </div>
                <div class="panel-header-actions">
                    <button class="panel-btn" onclick="toggleSidePanel()" title="Collapse panel"><span class="material-symbols-outlined">left_panel_close</span></button>
                    <button class="panel-btn" onclick="copyToClipboard()" title="Copy"><span class="material-symbols-outlined">content_copy</span></button>
                    <button class="panel-btn" onclick="download()" title="Download"><span class="material-symbols-outlined">download</span></button>
                </div>
            </div>
            <div class="panel-body" id="editorBody">
                <div class="editor-empty" id="editorEmpty">
                    <span class="material-symbols-outlined editor-empty-icon">code_off</span>
                    <span>Output will appear here after conversion</span>
                </div>
                <div class="editor-content hidden" id="editorContent">
                    <div class="editor-toolbar">
                        <div class="editor-toolbar-left">
                            <button class="editor-view-btn" id="btnViewJson" onclick="switchView('json')" title="Code view"><span class="material-symbols-outlined">data_object</span><span class="editor-view-label">Code</span></button>
                            <button class="editor-view-btn active" id="btnViewTree" onclick="switchView('tree')" title="Tree view"><span class="material-symbols-outlined">account_tree</span><span class="editor-view-label">Tree</span></button>
                        </div>
                    </div>
                    <div class="editor-code-wrap" id="editorCodeWrap">
                        <div class="code-controls" id="codeControls">
                            <button class="editor-view-btn" onclick="toggleEditMode()" title="Toggle edit mode (Ctrl+E)" id="editBtn"><span class="material-symbols-outlined" id="editModeIcon">edit</span><span class="editor-view-label" id="editModeLabel">Edit</span></button>
                            <button class="editor-view-btn" onclick="beautifyJSON()" title="Format JSON (Shift+Alt+F)" id="beautifyBtn"><span class="material-symbols-outlined">auto_fix_high</span><span class="editor-view-label">Format</span></button>
                            <button class="editor-view-btn" onclick="toggleFindBar()" title="Find & Replace (Ctrl+F)" id="findBtn"><span class="material-symbols-outlined">find_replace</span><span class="editor-view-label">Find</span></button>
                        </div>
                        <div class="find-bar hidden" id="findBar">
                            <div class="find-row find-main-row">
                                <span class="material-symbols-outlined find-icon">search</span>
                                <input type="text" id="findInput" class="find-input" placeholder="Find" autocomplete="off" spellcheck="false">
                                <span class="find-count" id="findCount"></span>
                                <button class="find-btn" onclick="findPrev()" title="Previous (Shift+Enter)"><span class="material-symbols-outlined">keyboard_arrow_up</span></button>
                                <button class="find-btn" onclick="findNext()" title="Next (Enter)"><span class="material-symbols-outlined">keyboard_arrow_down</span></button>
                                <button class="find-btn" id="findRegexBtn" onclick="toggleFindOption('regex')" title="Regex (Alt+R)"><span class="find-opt-icon">.*</span></button>
                                <button class="find-btn" id="findCaseBtn" onclick="toggleFindOption('case')" title="Match Case (Alt+C)"><span class="find-opt-icon">Aa</span></button>
                                <button class="find-btn find-close" onclick="closeFindBar()" title="Close (Escape)"><span class="material-symbols-outlined">close</span></button>
                            </div>
                            <div class="find-row find-replace-row">
                                <span class="material-symbols-outlined find-icon">swap_vert</span>
                                <input type="text" id="findReplaceInput" class="find-input" placeholder="Replace" autocomplete="off" spellcheck="false">
                                <button class="find-btn" onclick="findReplaceOne()" title="Replace"><span class="material-symbols-outlined">find_replace</span></button>
                                <button class="find-btn" onclick="findReplaceAll()" title="Replace All"><span class="material-symbols-outlined">done_all</span></button>
                            </div>
                        </div>
                        <div class="line-numbers" id="lineNumbers"></div>
                        <pre class="editor-highlight" id="editorHighlight"><code id="highlightCode"></code></pre>
                        <textarea id="preview" class="editor-textarea hidden" spellcheck="false" aria-label="JSON editor"></textarea>
                        <div class="autocomplete-dropdown hidden" id="autocompleteDropdown"></div>
                    </div>
                    <div class="tree-view hidden" id="treeView"></div>
                    <div class="editor-cache-bar hidden" id="cacheBar">
                        <span id="cacheInfo">Cached locally</span>
                        <button class="editor-cache-clear" onclick="clearCache()"><span class="material-symbols-outlined">delete</span> Clear</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Expand collapsed side panel -->
    <button class="expand-btn" id="expandBtn" style="display:none" onclick="toggleSidePanel()" title="Expand editor panel">
        <span class="material-symbols-outlined">left_panel_open</span>
    </button>
    <!-- BOTTOM: Log -->
    <div class="log-panel" id="logPanel">
        <div class="log-header" onclick="toggleLogPanel()">
            <div class="log-header-left">
                <span class="material-symbols-outlined log-header-icon">terminal</span>
                <span class="log-header-title">Activity Log</span>
                <span class="log-count" id="logCount">0</span>
            </div>
            <div class="log-header-actions">
                <button class="panel-btn" onclick="event.stopPropagation();clearLog()" title="Clear"><span class="material-symbols-outlined">delete_sweep</span></button>
                <button class="panel-btn" onclick="event.stopPropagation();toggleLogPanel()" title="Toggle"><span class="material-symbols-outlined" id="logToggleIcon">expand_less</span></button>
            </div>
        </div>
        <div class="log-body" id="logBody">
            <div class="log-entries" id="logEntries">
                <div class="log-empty" id="logEmpty"><span class="material-symbols-outlined log-empty-icon">receipt_long</span><span>No activity yet</span></div>
            </div>
        </div>
    </div>
    <script src="assets/app.js"></script>
</body>
</html>